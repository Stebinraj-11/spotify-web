{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/covers/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|covers).*)",
      "destination": "/index.html"
    }
  ]
}
