# Server Port & Binding (use 0.0.0.0 for cloud hosting)
PORT=5000
HOST=0.0.0.0

# Persistent Data Storage Directory (holds library.db, covers/, and music/)
# On cloud hosts like Render or Railway, point this to your mounted persistent disk (e.g. /data or /var/data)
DATA_DIR=./data

# Optional Custom Subdirectories (defaults to DATA_DIR subfolders)
# MUSIC_DIR=./data/music
# COVERS_DIR=./data/covers
# DB_PATH=./data/library.db

# Optional Single-User Password Protection for Hosting on Public Internet
# If set, visitors must enter this password once to unlock playback.
# If left blank, anyone with the URL can access playback.
APP_PASSWORD=

# Session Secret (change this if using password protection)
SESSION_SECRET=spotify-super-secret-random-key-change-me
